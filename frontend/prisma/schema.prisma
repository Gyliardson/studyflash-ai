// [MANTIDO] Configuração do Client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === MODELS ===

model Flashcard {
  id        String   @id @default(uuid())
  userId    String
  frente    String
  verso     String
  createdAt DateTime @default(now())

  // --- RELAÇÕES DE ORGANIZAÇÃO ---

  // 1. Modo Clássico (Decks Soltos)
  deckId String?
  deck   Deck?   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  // 2. Novo Modo Estruturado (v0.3.0)
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // --- CAMPOS SRS (Sistema de Repetição Espaçada) ---
  nextReview     DateTime @default(now())
  interval       Int      @default(0)
  repetition     Int      @default(0)
  easinessFactor Float    @default(2.5)

  // --- RELAÇÃO AO SIMULADO ---
  examResults ExamQuestion[]

  @@index([userId])
  @@index([userId, nextReview])
  @@index([topicId]) // Indexação para performance no carregamento do tópico
}

model Deck {
  id        String      @id @default(uuid())
  userId    String
  nome      String
  createdAt DateTime    @default(now())
  cards     Flashcard[]

  @@index([userId])
}

// --- NOVOS MODELS: PLANOS DE ESTUDO ---

model StudyPlan {
  id          String  @id @default(uuid())
  userId      String
  title       String // Ex: "Dominar React.js"
  description String? // Contexto ou resumo gerado pela IA
  difficulty  String // "Iniciante", "Intermediário", "Avançado"
  status      String  @default("active") // 'active', 'completed', 'archived'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@index([userId])
}

model Topic {
  id String @id @default(uuid())

  // Relação Pai (Plano)
  planId String
  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  title       String // Ex: "Módulo 1: Hooks Básicos"
  order       Int // Para ordenação visual (1, 2, 3...)
  isCompleted Boolean @default(false) // Check de conclusão

  // Conteúdo Gerado
  cards Flashcard[]

  @@index([planId])
}

// --- NOVOS MODELS: MODO SIMULADO (v0.5.0) ---

model ExamSession {
  id               String   @id @default(uuid())
  userId           String
  sourceDeckId     String? // Se for um Deck
  sourceTopicId    String? // Se for um Tópico
  sourcePlanId     String? // [NOVO] Se for uma Trilha Completa
  sourceType       String // 'DECK', 'TOPIC', 'PLAN', 'GLOBAL'
  totalQuestions   Int
  correctAnswers   Int
  score            Float // Porcentagem de acerto (0.0 a 1.0)
  timeSpentSeconds Int
  difficulty       String // 'EASY', 'MEDIUM', 'HARD', 'IMPOSSIBLE'
  xpAwarded        Int
  createdAt        DateTime @default(now())

  questions ExamQuestion[]

  @@index([userId])
}

model ExamQuestion {
  id        String      @id @default(uuid())
  sessionId String
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Link para o cartão original (SEM DUPLICAÇÃO)
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  isCorrect        Boolean
  timeTakenSeconds Float?

  @@index([sessionId])
  @@index([flashcardId])
}

// === GAMIFICATION SYSTEM (v0.4.0) ===

model UserProfile {
  userId   String @id @unique // ID do Clerk
  xp       Int    @default(0)
  level    Int    @default(1)
  weeklyXp Int    @default(0)

  // Streak System
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?

  // Recompensas desbloqueadas
  unlockedRewards UserReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  // Opcional: Adicionar índice para o leaderboard ser rápido
  @@index([weeklyXp(sort: Desc)])
}

model Reward {
  id            String @id @default(uuid())
  slug          String @unique // Identificador fixo no código (ex: theme-dark)
  name          String
  description   String
  requiredLevel Int
  type          String // 'COSMETIC', 'FEATURE'

  users UserReward[]
}

model UserReward {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  obtainedAt DateTime @default(now())

  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reward Reward      @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId]) // Um usuário só desbloqueia a recompensa uma vez
  @@index([userId])
}

// Opcional: Log para auditoria e features futuras (Simulados)
model XPHistory {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  source    String // 'REVIEW', 'CREATE_CARD', 'STREAK_BONUS', 'SIMULADO'
  createdAt DateTime @default(now())

  @@index([userId])
}
