{
  "version": "2.0.0",
  "presentation": {
    "echo": false,
    "reveal": "always",
    "focus": false,
    "panel": "dedicated", // <--- O SEGREDO: Reutiliza o terminal da tarefa
    "showReuseMessage": false
  },
  "tasks": [
    {
      "label": "BackEnd", // <--- Nome que vai aparecer na aba
      "type": "shell",
      "command": ".\\venv\\Scripts\\activate ; uvicorn app.main:app --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "FrontEnd", // <--- Nome que vai aparecer na aba
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Iniciar tudo",
      "dependsOn": ["BackEnd", "FrontEnd"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}